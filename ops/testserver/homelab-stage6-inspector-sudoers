# Stage 6 Jenkins inspector sudo boundary.
# Service selection is generic but constrained to the same safe identifier grammar
# enforced by the root-owned inspectors and requires reviewed root-owned manifests.

homelab-stage6-inspector ALL=(root) NOPASSWD: /usr/local/libexec/homelab-stage6-inspect ^[a-z0-9][a-z0-9-]*$
homelab-stage6-inspector ALL=(root) NOPASSWD: /usr/local/libexec/homelab-stage6-steady-inspect ^[a-z0-9][a-z0-9-]*$
