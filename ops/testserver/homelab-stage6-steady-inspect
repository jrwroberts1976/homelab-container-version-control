#!/bin/bash
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

MANIFEST_DIR="/etc/homelab-stage6/steady-state"
VALIDATOR="/usr/local/libexec/homelab-stage6-validate-steady-state-manifest"
INSTALLED_SELF="/usr/local/libexec/homelab-stage6-steady-inspect"
AUTHORITY_ROOT="/var/lib/homelab-stage6/authority/docker-env"
LIVE_ROOT="/home/james/docker"

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    exit 2
}

require_secure_root_file() {
    local file="$1"
    [ -f "$file" ] || fail "required root-owned file missing: $file"
    [ ! -L "$file" ] || fail "root-owned file must not be a symlink: $file"
    [ "$(stat -c '%U:%G' "$file")" = "root:root" ] || fail "file is not root:root: $file"
    if find "$file" -maxdepth 0 -perm /022 -print -quit | grep -q .; then
        fail "file is group/other writable: $file"
    fi
}

require_secure_root_dir() {
    local dir="$1"
    [ -d "$dir" ] || fail "required root-owned directory missing: $dir"
    [ ! -L "$dir" ] || fail "root-owned directory must not be a symlink: $dir"
    [ "$(stat -c '%U:%G' "$dir")" = "root:root" ] || fail "directory is not root:root: $dir"
    if find "$dir" -maxdepth 0 -perm /022 -print -quit | grep -q .; then
        fail "directory is group/other writable: $dir"
    fi
}

manifest_string() {
    local query="$1"
    jq -er "$query | strings | select(length > 0)" "$MANIFEST" 2>/dev/null ||
        fail "manifest value unavailable: $query"
}

verify_hash() {
    local file="$1"
    local expected="$2"
    local actual
    [ -f "$file" ] || fail "required file missing: $file"
    [ ! -L "$file" ] || fail "required file must not be a symlink: $file"
    actual="$(sha256sum "$file" | awk '{print $1}')"
    [ "$actual" = "$expected" ] || fail "SHA-256 mismatch: $file"
}

render_desired_image() {
    env "$IMAGE_VARIABLE=$DESIRED_REF" \
        docker compose \
            --project-directory "$PROJECT_DIR" \
            -p "$COMPOSE_PROJECT" \
            -f "$COMPOSE_FILE" \
            config |
    awk -v service="$COMPOSE_SERVICE" '
        $0 == "  " service ":" {
            active=1
            next
        }
        active && /^    image:/ {
            sub(/^    image: /, "")
            gsub(/^"|"$/, "")
            print
            exit
        }
    '
}

verify_git_authority() {
    local expected_commit expected_sha actual_commit status relative resolved authority_path

    require_secure_root_dir "$AUTHORITY_ROOT"
    expected_commit="$(manifest_string '.authority.revision')"
    expected_sha="$(manifest_string '.authority.compose_sha256')"

    authority_path="$(jq -r '.authority.compose_path // ""' "$MANIFEST")"

    if [ -n "$authority_path" ]; then
        relative="$authority_path"
        [[ "$relative" != /* ]] || fail "reviewed authority Compose path must be relative"
        [[ "/$relative/" != *"/../"* ]] || fail "reviewed authority Compose path traversal blocked"
    else
        [[ "$COMPOSE_FILE" = "$LIVE_ROOT/"* ]] || fail "live Compose file is outside fixed runtime root"
        relative="${COMPOSE_FILE#${LIVE_ROOT}/}"
        [[ "$relative" != /* ]] || fail "derived authority Compose path must be relative"
        [[ "/$relative/" != *"/../"* ]] || fail "derived authority Compose path traversal blocked"
    fi

    actual_commit="$(git -C "$AUTHORITY_ROOT" rev-parse HEAD 2>/dev/null)" || fail "authority Git commit unavailable"
    [ "$actual_commit" = "$expected_commit" ] || fail "authority Git commit mismatch"

    status="$(git -C "$AUTHORITY_ROOT" status --porcelain 2>/dev/null)" || fail "authority Git status unavailable"
    [ -z "$status" ] || fail "authority checkout is not clean"

    AUTHORITY_COMPOSE="${AUTHORITY_ROOT}/${relative}"
    resolved="$(readlink -f "$AUTHORITY_COMPOSE")"
    [[ "$resolved" = "$AUTHORITY_ROOT/"* ]] || fail "authority Compose path escapes checkout"

    require_secure_root_file "$AUTHORITY_COMPOSE"
    verify_hash "$AUTHORITY_COMPOSE" "$expected_sha"
    verify_hash "$COMPOSE_FILE" "$expected_sha"
}

verify_compose_capability() {
    local rendered
    rendered="$(render_desired_image)"
    [ "$rendered" = "$DESIRED_REF" ] || fail "Compose desired override is not exact immutable desired image"
}

verify_desired_image() {
    local image_json version revision
    image_json="$(docker image inspect "$DESIRED_REF" 2>/dev/null)" || fail "desired immutable image is not local"

    [ "$(jq -r '.[0].Id' <<<"$image_json")" = "$DESIRED_LOCAL_ID" ] || fail "desired local image ID mismatch"
    [ "$(jq -r '.[0].Os' <<<"$image_json")" = "$DESIRED_OS" ] || fail "desired OS mismatch"
    [ "$(jq -r '.[0].Architecture' <<<"$image_json")" = "$DESIRED_ARCH" ] || fail "desired architecture mismatch"

    jq -e --arg ref "$DESIRED_REF" '.[0].RepoDigests // [] | index($ref) != null' <<<"$image_json" >/dev/null ||
        fail "desired RepoDigests missing exact immutable ref"

    case "$METADATA_VERIFICATION" in
        digest-pinned)
            ;;
        oci-labels)
            version="$(jq -r '.[0].Config.Labels["org.opencontainers.image.version"] // ""' <<<"$image_json")"
            revision="$(jq -r '.[0].Config.Labels["org.opencontainers.image.revision"] // ""' <<<"$image_json")"
            [ "$version" = "$DESIRED_VERSION" ] || fail "desired OCI version mismatch"
            [ "$revision" = "$DESIRED_REVISION" ] || fail "desired OCI revision mismatch"
            ;;
        *)
            fail "unsupported metadata verification mode"
            ;;
    esac
}

verify_runtime() {
    local expected_networks actual_networks expected_ports actual_ports
    local expected_mounts actual_mounts expected_user expected_privileged
    local expected_readonly expected_restart source source_kind expected_sha actual_sha
    local socket_allowed

    CONTAINER_JSON="$(docker inspect "$TARGET_CONTAINER" 2>/dev/null)" || fail "target container unavailable"

    [ "$(jq -r '.[0].State.Running' <<<"$CONTAINER_JSON")" = "true" ] || fail "target container is not running"
    [ "$(jq -r '.[0].Image' <<<"$CONTAINER_JSON")" = "$DESIRED_LOCAL_ID" ] || fail "target is not exact desired local image"
    [ "$(jq -r '.[0].Config.Image' <<<"$CONTAINER_JSON")" = "$DESIRED_CONFIGURED_IMAGE" ] || fail "target configured image is not exact desired immutable ref"

    expected_networks="$(jq -c '.runtime.networks | sort' "$MANIFEST")"
    actual_networks="$(jq -c '.[0].NetworkSettings.Networks | keys | sort' <<<"$CONTAINER_JSON")"
    [ "$actual_networks" = "$expected_networks" ] || fail "target network membership mismatch"

    expected_ports="$(jq -S -c '.runtime.published_ports | sort_by(.container_port, .protocol, .host_ip, .host_port)' "$MANIFEST")"
    actual_ports="$(jq -S -c '
      [
        ((.[0].NetworkSettings.Ports // {}) | to_entries[]) as $entry
        | select($entry.value != null)
        | ($entry.key | capture("^(?<port>[0-9]+)/(?<protocol>tcp|udp)$")) as $cp
        | $entry.value[]
        | {
            host_ip: .HostIp,
            host_port: (.HostPort | tonumber),
            container_port: ($cp.port | tonumber),
            protocol: $cp.protocol
          }
      ]
      | sort_by(.container_port, .protocol, .host_ip, .host_port)
    ' <<<"$CONTAINER_JSON")"
    [ "$actual_ports" = "$expected_ports" ] || fail "target published-port shape mismatch"

    expected_mounts="$(jq -S -c '[.runtime.mounts[] | {type, source, destination, rw}] | sort_by(.destination, .source)' "$MANIFEST")"
    actual_mounts="$(jq -S -c '[.[0].Mounts[] | {type: .Type, source: .Source, destination: .Destination, rw: .RW}] | sort_by(.destination, .source)' <<<"$CONTAINER_JSON")"
    [ "$actual_mounts" = "$expected_mounts" ] || fail "target mount shape mismatch"

    while IFS=$'\t' read -r source source_kind expected_sha; do
        [ -n "$source" ] || continue
        [ ! -L "$source" ] || fail "bind-mount source must not be a symlink: $source"
        case "$source_kind" in
            file)
                [ -f "$source" ] || fail "bind-mount file missing: $source"
                actual_sha="$(sha256sum "$source" | awk '{print $1}')"
                [ "$actual_sha" = "$expected_sha" ] || fail "bind-mount content hash mismatch: $source"
                ;;
            directory)
                [ -d "$source" ] || fail "bind-mount directory missing: $source"
                [ -z "$expected_sha" ] || fail "directory mount must not carry SHA-256: $source"
                ;;
            socket)
                [ "$source" = "/var/run/docker.sock" ] || fail "socket bind source is not reviewed Docker socket"
                [ -S "$source" ] || fail "reviewed Docker socket source is not a Unix socket"
                [ -z "$expected_sha" ] || fail "socket mount must not carry SHA-256"
                ;;
            *)
                fail "unsupported bind-mount source kind"
                ;;
        esac
    done < <(jq -r '.runtime.mounts[] | [.source, .source_kind, (.sha256 // "")] | @tsv' "$MANIFEST")

    expected_user="$(jq -r '.runtime.user' "$MANIFEST")"
    expected_privileged="$(jq -r '.runtime.privileged' "$MANIFEST")"
    expected_readonly="$(jq -r '.runtime.readonly_rootfs' "$MANIFEST")"
    expected_restart="$(jq -r '.runtime.restart_policy' "$MANIFEST")"

    [ "$(jq -r '.[0].Config.User // ""' <<<"$CONTAINER_JSON")" = "$expected_user" ] || fail "target user mismatch"
    [ "$(jq -r '.[0].HostConfig.Privileged' <<<"$CONTAINER_JSON")" = "$expected_privileged" ] || fail "target privileged state mismatch"
    [ "$(jq -r '.[0].HostConfig.ReadonlyRootfs' <<<"$CONTAINER_JSON")" = "$expected_readonly" ] || fail "target read-only rootfs state mismatch"
    [ "$(jq -r '.[0].HostConfig.RestartPolicy.Name' <<<"$CONTAINER_JSON")" = "$expected_restart" ] || fail "target restart policy mismatch"
    [ "$(jq -r '.[0].HostConfig.Devices | length' <<<"$CONTAINER_JSON")" = "0" ] || fail "target unexpectedly has device mappings"

    socket_allowed="$(jq -r '.runtime.docker_socket_allowed' "$MANIFEST")"
    if [ "$socket_allowed" = "true" ]; then
        jq -e '
          ([.[0].Mounts[] | select(.Type == "bind" and .Source == "/var/run/docker.sock" and .Destination == "/var/run/docker.sock" and .RW == false)] | length == 1)
          and
          ([.[0].Mounts[] | select((.Source | contains("docker.sock")) or (.Destination | contains("docker.sock")))] | length == 1)
        ' <<<"$CONTAINER_JSON" >/dev/null || fail "Docker socket mount is not exact reviewed read-only socket"
    else
        jq -e '[.[0].Mounts[] | select((.Source | contains("docker.sock")) or (.Destination | contains("docker.sock")))] | length == 0' <<<"$CONTAINER_JSON" >/dev/null ||
            fail "target unexpectedly has Docker socket mount"
    fi
}

verify_content_checks() {
    local mount_source relative expected_sha
    local current part actual_sha other_source
    local -a parts

    CONTENT_CHECKS_JSON='[]'

    while IFS=$'\t' read -r \
        mount_source relative expected_sha
    do
        [ -n "$mount_source" ] || continue

        jq -e \
            --arg source "$mount_source" '
              [
                .runtime.mounts[]
                | select(
                    .source_kind == "directory"
                    and .source == $source
                  )
              ]
              | length == 1
            ' "$MANIFEST" >/dev/null ||
            fail "content check mount source is not an exact directory mount"

        [ -d "$mount_source" ] ||
            fail "content check mount source missing: $mount_source"

        [ ! -L "$mount_source" ] ||
            fail "content check mount source is a symlink: $mount_source"

        case "$relative" in
            ""|/*)
                fail "content check relative path invalid"
                ;;
        esac

        IFS='/' read -r -a parts <<<"$relative"

        current="${mount_source%/}"

        for part in "${parts[@]}"; do
            [ -n "$part" ] ||
                fail "content check path contains empty component"

            [ "$part" != "." ] ||
                fail "content check path contains dot component"

            [ "$part" != ".." ] ||
                fail "content check path traversal rejected"

            current="${current}/${part}"

            [ ! -L "$current" ] ||
                fail "content check path contains symlink: $current"
        done

        [ -f "$current" ] ||
            fail "content check file missing: $current"

        while IFS= read -r other_source; do
            [ -n "$other_source" ] || continue
            [ "$other_source" != "$mount_source" ] || continue

            other_source="${other_source%/}"

            case "$other_source/" in
                "${mount_source%/}/"*)
                    case "$current" in
                        "$other_source"/*)
                            fail \
                              "content check crosses a more-specific directory mount boundary"
                            ;;
                    esac
                    ;;
            esac
        done < <(
            jq -r '
              .runtime.mounts[]
              | select(.source_kind == "directory")
              | .source
            ' "$MANIFEST"
        )

        actual_sha="$(
            sha256sum "$current" |
            awk '{print $1}'
        )"

        [ "$actual_sha" = "$expected_sha" ] ||
            fail "content check SHA-256 mismatch: $current"

        CONTENT_CHECKS_JSON="$(
            jq -c \
                --arg mount_source "$mount_source" \
                --arg relative_path "$relative" \
                --arg path "$current" \
                --arg sha256 "$actual_sha" '
                  . + [
                    {
                      mount_source: $mount_source,
                      relative_path: $relative_path,
                      path: $path,
                      sha256: $sha256,
                      verified: true
                    }
                  ]
                ' <<<"$CONTENT_CHECKS_JSON"
        )"
    done < <(
        jq -r '
          (.runtime.content_checks // [])[]
          | [
              .mount_source,
              .relative_path,
              .sha256
            ]
          | @tsv
        ' "$MANIFEST"
    )
}

verify_health() {
    local strategy expected url status code
    strategy="$(manifest_string '.health.strategy')"
    expected="$(manifest_string '.health.expected')"

    case "$strategy" in
        docker-health)
            status="$(jq -r '.[0].State.Health.Status // "none"' <<<"$CONTAINER_JSON")"
            [ "$status" = "$expected" ] || fail "Docker health mismatch"
            HEALTH_EVIDENCE="$(jq -n --arg strategy "$strategy" --arg status "$status" '{strategy:$strategy,status:$status}')"
            ;;
        http)
            url="$(manifest_string '.health.url')"
            code="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 10 "$url")" || fail "HTTP health request failed"
            [ "$code" = "$expected" ] || fail "HTTP health status mismatch"
            HEALTH_EVIDENCE="$(jq -n --arg strategy "$strategy" --arg url "$url" --arg status "$code" '{strategy:$strategy,url:$url,status:$status}')"
            ;;
        *)
            fail "unsupported health strategy"
            ;;
    esac
}

capture_protected() {
    local name json
    PROTECTED_JSON='[]'
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        json="$(docker inspect "$name" 2>/dev/null)" || fail "protected container unavailable: $name"
        [ "$(jq -r '.[0].State.Running' <<<"$json")" = "true" ] || fail "protected container is not running: $name"
        PROTECTED_JSON="$(jq -c \
            --arg name "$name" \
            --arg id "$(jq -r '.[0].Id' <<<"$json")" \
            --argjson restarts "$(jq -r '.[0].RestartCount' <<<"$json")" \
            '. + [{name:$name,container_id:$id,restart_count:$restarts,running:true}]' \
            <<<"$PROTECTED_JSON")"
    done < <(jq -r '.protection.containers[]? // empty' "$MANIFEST")
}

[ "$(id -u)" = "0" ] || fail "steady-state inspector must run as root"
[ "$#" -eq 1 ] || fail "usage: homelab-stage6-steady-inspect SERVICE"
SERVICE="$1"
[[ "$SERVICE" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid service name"

MANIFEST="${MANIFEST_DIR}/${SERVICE}.json"
require_secure_root_file "$INSTALLED_SELF"
require_secure_root_file "$VALIDATOR"
require_secure_root_file "$MANIFEST"
"$VALIDATOR" "$MANIFEST" >/dev/null || fail "steady-state manifest validation failed"

[ "$(manifest_string '.service.name')" = "$SERVICE" ] || fail "manifest service mismatch"
MANIFEST_HOST="$(manifest_string '.service.host')"
CURRENT_HOST="$(hostname -s)"

case "$MANIFEST_HOST" in
    TestServer|ids-01)
        ;;
    *)
        fail "manifest host is not a reviewed steady-state Docker host"
        ;;
esac

[ "$CURRENT_HOST" = "$MANIFEST_HOST" ] ||
    fail "manifest host does not match local machine"

[ "$(manifest_string '.service.image_type')" = "registry-image" ] || fail "unsupported image type"

TARGET_CONTAINER="$(manifest_string '.service.container')"
PROJECT_DIR="$(manifest_string '.service.compose.project_directory')"
COMPOSE_PROJECT="$(manifest_string '.service.compose.project')"
COMPOSE_FILE="$(manifest_string '.service.compose.compose_file')"
COMPOSE_SERVICE="$(manifest_string '.service.compose.service')"
IMAGE_VARIABLE="$(manifest_string '.service.compose.image_variable')"
DESIRED_VERSION="$(manifest_string '.desired.version')"
DESIRED_CONFIGURED_IMAGE="$(manifest_string '.desired.configured_image')"
DESIRED_REF="$(manifest_string '.desired.immutable_ref')"
DESIRED_LOCAL_ID="$(manifest_string '.desired.local_image_id')"
DESIRED_OS="$(manifest_string '.desired.platform.os')"
DESIRED_ARCH="$(manifest_string '.desired.platform.architecture')"
METADATA_VERIFICATION="$(manifest_string '.desired.metadata_verification')"
DESIRED_REVISION="$(jq -r '.desired.revision // ""' "$MANIFEST")"
MANIFEST_SHA="$(sha256sum "$MANIFEST" | awk '{print $1}')"

verify_git_authority
verify_compose_capability
verify_desired_image
verify_runtime
verify_content_checks
verify_health
capture_protected

CONTAINER_ID="$(jq -r '.[0].Id' <<<"$CONTAINER_JSON")"
RESTART_COUNT="$(jq -r '.[0].RestartCount' <<<"$CONTAINER_JSON")"
AUTHORITY_REVISION="$(manifest_string '.authority.revision')"
COMPOSE_SHA="$(manifest_string '.authority.compose_sha256')"
NETWORKS="$(jq -c '.[0].NetworkSettings.Networks | keys | sort' <<<"$CONTAINER_JSON")"
MOUNTS="$(jq -S -c '[.[0].Mounts[] | {type:.Type,source:.Source,destination:.Destination,rw:.RW}] | sort_by(.destination,.source)' <<<"$CONTAINER_JSON")"
PORTS="$(jq -S -c '[((.[0].NetworkSettings.Ports // {}) | to_entries[]) as $entry | select($entry.value != null) | ($entry.key | capture("^(?<port>[0-9]+)/(?<protocol>tcp|udp)$")) as $cp | $entry.value[] | {host_ip:.HostIp,host_port:(.HostPort|tonumber),container_port:($cp.port|tonumber),protocol:$cp.protocol}] | sort_by(.container_port,.protocol,.host_ip,.host_port)' <<<"$CONTAINER_JSON")"

jq -n \
  --arg artifact "service-steady-state-inspection" \
  --arg service "$SERVICE" \
  --arg host "$MANIFEST_HOST" \
  --arg manifest "$MANIFEST" \
  --arg manifest_sha256 "$MANIFEST_SHA" \
  --arg authority_revision "$AUTHORITY_REVISION" \
  --arg compose_sha256 "$COMPOSE_SHA" \
  --arg version "$DESIRED_VERSION" \
  --arg configured_image "$DESIRED_CONFIGURED_IMAGE" \
  --arg immutable_ref "$DESIRED_REF" \
  --arg local_image_id "$DESIRED_LOCAL_ID" \
  --arg container_id "$CONTAINER_ID" \
  --argjson restart_count "$RESTART_COUNT" \
  --argjson networks "$NETWORKS" \
  --argjson ports "$PORTS" \
  --argjson mounts "$MOUNTS" \
  --argjson content_checks "$CONTENT_CHECKS_JSON" \
  --argjson health "$HEALTH_EVIDENCE" \
  --argjson protected "$PROTECTED_JSON" \
  '{
    schema_version:1,
    artifact:$artifact,
    mode:"read-only",
    service:$service,
    host:$host,
    manifest:{path:$manifest,sha256:$manifest_sha256},
    authority:{repository:"docker-env",revision:$authority_revision,compose_sha256:$compose_sha256,clean:true},
    desired:{version:$version,configured_image:$configured_image,immutable_ref:$immutable_ref,local_image_id:$local_image_id},
    runtime:{container_id:$container_id,restart_count:$restart_count,running:true,networks:$networks,published_ports:$ports,mounts:$mounts,content_checks:$content_checks},
    health:$health,
    protected_containers:$protected,
    mutation_allowed:false,
    deployment:{allowed:false,performed:false},
    result:"steady-state-verified"
  }'
