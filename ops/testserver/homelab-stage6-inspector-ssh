#!/bin/bash
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

COMMAND="${SSH_ORIGINAL_COMMAND:-}"

case "$COMMAND" in
    ping)
        printf 'pong\n'
        ;;
    "inspect dashy")
        exec sudo -n /usr/local/libexec/homelab-stage6-inspect dashy
        ;;
    *)
        printf 'FAIL: command not permitted\n' >&2
        exit 2
        ;;
esac
