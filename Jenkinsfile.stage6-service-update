pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
  }

  parameters {
    choice(
      name: 'STAGE6_ACTION',
      choices: ['VERIFY_CLOSED', 'UPDATE'],
      description: 'VERIFY_CLOSED proves existing closed state without mutation; UPDATE runs the reviewed deployment path'
    )

    string(
      name: 'STAGE6_MANIFEST',
      defaultValue: '',
      description: 'Reviewed manifest filename under config/services'
    )
  }

  environment {
    STAGE6_EXECUTOR_KEY_NORMALIZER_SHA256 = 'acd2c312db447a98d735b38ebb6fe69270ade7caebb8f0e2668f0bf65e3d861f'
    STAGE6_FRAMEWORK_BASE_COMMIT = '71685570399e51fbd44fe7b1a71bd2efebc94a24'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Prepare missing manifest') {
      steps {
        script {
          def action = params.STAGE6_ACTION?.trim()
          if (!(action in ['VERIFY_CLOSED', 'UPDATE'])) {
            error('STAGE6_ACTION must be VERIFY_CLOSED or UPDATE')
          }

          def manifestName = params.STAGE6_MANIFEST?.trim()

          if (!manifestName ||
              !(manifestName ==~ /^[a-z0-9][a-z0-9.-]*\.json$/)) {
            error('STAGE6_MANIFEST must be one safe manifest filename ending in .json')
          }

          def manifestPath = "config/services/${manifestName}"

          if (fileExists(manifestPath)) {
            env.STAGE6_MANIFEST_PREPARED = 'false'
            echo("PASS: reviewed Stage 6 manifest already present: ${manifestPath}")
          } else {
            env.STAGE6_MANIFEST_PREPARED = 'true'

            sh '''
              set -eu
              set +x

              python3 scripts/prepare-stage6-service-manifest.py \
                --manifest-name "$STAGE6_MANIFEST" \
                --output-dir artifacts
            '''

            def preparedPath = "artifacts/${manifestName}"

            if (!fileExists(preparedPath)) {
              error("Prepared Stage 6 manifest not found: ${preparedPath}")
            }

            echo("MANIFEST_PREPARED_REVIEW_REQUIRED: ${preparedPath}")
          }
        }
      }
    }

    stage('Manifest review required') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED == 'true'
        }
      }
      steps {
        echo('SUCCESS: requested Stage 6 manifest prepared and archived; review/commit required before deployment')
      }
    }

    stage('Load reviewed manifest') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true'
        }
      }
      steps {
        script {
          def action = params.STAGE6_ACTION?.trim()
          if (!(action in ['VERIFY_CLOSED', 'UPDATE'])) {
            error('STAGE6_ACTION must be VERIFY_CLOSED or UPDATE')
          }

          def manifestName = params.STAGE6_MANIFEST?.trim()

          if (!manifestName || !(manifestName ==~ /^[a-z0-9][a-z0-9.-]*\.json$/)) {
            error('STAGE6_MANIFEST must be one safe manifest filename ending in .json')
          }

          def manifestPath = "config/services/${manifestName}"
          if (!fileExists(manifestPath)) {
            error("Reviewed Stage 6 manifest not found: ${manifestPath}")
          }

          env.STAGE6_MANIFEST_PATH = manifestPath

          sh '''
            set -eu
            set +x

            python3 scripts/validate-stage6-service-manifest.py \
              "$STAGE6_MANIFEST_PATH" \
              --schema config/service-update-manifest.schema.json
          '''

          def raw = readFile(manifestPath)
          def m = new groovy.json.JsonSlurperClassic().parseText(raw)

          def service = m.service?.name?.toString()
          if (!service || !(service ==~ /^[a-z0-9][a-z0-9-]*$/)) {
            error('Manifest service name is not safe')
          }

          def manifestHost = m.service?.host?.toString()

          def hostRoutes = [
            'TestServer': [
              address: '172.30.255.249',
              knownHosts: '/var/jenkins_home/.ssh/stage4-testserver-known_hosts',
              hostKeyFingerprint: 'SHA256:PEDpP7QlmSztJSIYHzZ+YuIT7XurmpeWp85wRnlfZuk',
              inspectorCredential: 'homelab-stage6-testserver-inspector',
              executorCredential: 'homelab-stage6-testserver-executor',
              executorFingerprint: 'SHA256:A9VBS2vpB6+OvA62GhWXIMTgsNc2DdqOUX4eqLR58gY'
            ],
            'ids-01': [
              address: '192.168.2.242',
              knownHosts: '/var/jenkins_home/.ssh/stage6-ids01-known_hosts',
              hostKeyFingerprint: 'SHA256:kzg4d7EDJoRJ7upaDxo3h23pbxJDMjwf+gOGeNTst8Y',
              inspectorCredential: 'homelab-stage6-ids01-inspector',
              executorCredential: 'homelab-stage6-ids01-executor',
              executorFingerprint: 'SHA256:p7eXjRzsk7fM7zI71cio7bB60XdHEXNIkgXGgyrEpX0'
            ]
          ]

          def route = hostRoutes[manifestHost]

          if (route == null) {
            error('Manifest host is outside the reviewed Stage 6 routing table')
          }

          if (m.service?.container?.toString() != service ||
              m.service?.compose?.service?.toString() != service ||
              m.service?.image_type?.toString() != 'registry-image') {
            error('Manifest service identity is outside the Stage 6 generic contract')
          }

          def rollback = m.versions?.rollback
          def candidate = m.versions?.candidate
          def candidateDigest = candidate?.index_digest?.toString()

          if (!candidateDigest || !(candidateDigest ==~ /^sha256:[0-9a-f]{64}$/)) {
            error('Manifest candidate index digest is invalid')
          }

          def healthStrategy = m.health?.strategy?.toString()
          def healthResult
          if (healthStrategy == 'docker-health') {
            healthResult = m.health?.expected?.toString()
          } else if (healthStrategy == 'http' ||
                     healthStrategy == 'container-http') {
            healthResult = "http-${m.health?.expected_status}"
          } else {
            error('Manifest health strategy is unsupported')
          }

          env.STAGE6_SERVICE = service
          env.STAGE6_MANIFEST_HOST = manifestHost
          env.STAGE6_HOST = route.address
          env.STAGE6_KNOWN_HOSTS = route.knownHosts
          env.STAGE6_HOSTKEY_FINGERPRINT = route.hostKeyFingerprint
          env.STAGE6_INSPECTOR_CREDENTIAL = route.inspectorCredential
          env.STAGE6_EXECUTOR_CREDENTIAL = route.executorCredential
          env.STAGE6_EXECUTOR_FINGERPRINT = route.executorFingerprint
          env.STAGE6_UPDATE_ID = "stage6-${service}-${candidateDigest.substring(7)}"
          env.STAGE6_AUTHORITY_COMMIT = m.authority?.revision?.toString()
          env.STAGE6_COMPOSE_SHA256 = m.authority?.compose_sha256?.toString()

          env.STAGE6_ROLLBACK_VERSION = rollback?.version?.toString()
          env.STAGE6_ROLLBACK_REF = rollback?.immutable_ref?.toString()
          env.STAGE6_ROLLBACK_IMAGE_ID = rollback?.local_image_id?.toString()
          env.STAGE6_ROLLBACK_PLATFORM = "${rollback?.platform?.os}/${rollback?.platform?.architecture}"
          env.STAGE6_ROLLBACK_CONFIGURED_IMAGE = rollback?.configured_image?.toString()

          env.STAGE6_CANDIDATE_VERSION = candidate?.version?.toString()
          env.STAGE6_CANDIDATE_REF = candidate?.immutable_ref?.toString()
          env.STAGE6_CANDIDATE_IMAGE_ID = (candidate?.local_image_id ?: candidate?.config_digest)?.toString()
          env.STAGE6_CANDIDATE_PLATFORM_MANIFEST = candidate?.platform_manifest_digest?.toString()
          env.STAGE6_CANDIDATE_REVISION = candidate?.revision?.toString()
          env.STAGE6_CANDIDATE_METADATA_VERIFICATION = (candidate?.metadata_verification ?: 'oci-labels').toString()
          env.STAGE6_CANDIDATE_PLATFORM = "${candidate?.platform?.os}/${candidate?.platform?.architecture}"

          env.STAGE6_HEALTH_STRATEGY = healthStrategy
          env.STAGE6_HEALTH_RESULT = healthResult
          env.STAGE6_ARTIFACT_PREFIX = "artifacts/stage6-${service}"

          env.STAGE6_MANIFEST_SHA256 = sh(
            returnStdout: true,
            script: '''sha256sum "$STAGE6_MANIFEST_PATH" | awk '{print $1}' '''
          ).trim()

          env.STAGE6_INSPECTOR_SOURCE_SHA256 = sh(
            returnStdout: true,
            script: '''sha256sum ops/testserver/homelab-stage6-inspect | awk '{print $1}' '''
          ).trim()

          echo("PASS: loaded reviewed Stage 6 manifest ${manifestName} for service ${service}")
        }
      }
    }

    stage('VERIFY_CLOSED') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'VERIFY_CLOSED'
        }
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: env.STAGE6_INSPECTOR_CREDENTIAL,
            keyFileVariable: 'STAGE6_INSPECT_KEY',
            usernameVariable: 'STAGE6_INSPECT_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            python3 scripts/stage6-verify-closed.py \
              --manifest "$STAGE6_MANIFEST_PATH" \
              --host "$STAGE6_HOST" \
              --known-hosts "$STAGE6_KNOWN_HOSTS" \
              --hostkey-fingerprint "$STAGE6_HOSTKEY_FINGERPRINT" \
              --ssh-user "$STAGE6_INSPECT_USER" \
              --ssh-key "$STAGE6_INSPECT_KEY" \
              --artifact-dir artifacts
          '''
        }
      }
    }

    stage('Source and host-key preflight') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        sh '''
          set -eu
          set +x

          test -f ops/testserver/homelab-stage6-inspect
          test -f ops/testserver/homelab-stage6-inspector-ssh
          test -f ops/testserver/homelab-stage6-transition
          test -f ops/testserver/homelab-stage6-execute
          test -f ops/testserver/homelab-stage6-executor-ssh
          test -f ops/ids01/homelab-stage6-inspector-ssh
          test -f ops/ids01/homelab-stage6-executor-ssh
          test -f ops/ids01/homelab-stage6-inspector-sudoers
          test -f ops/ids01/homelab-stage6-executor-sudoers
          test -f ops/ids01/homelab-stage6-inspector-authorized-key.template
          test -f ops/ids01/homelab-stage6-executor-authorized-key.template
          test -f scripts/stage6-normalize-executor-key.sh
          test -f scripts/validate-stage6-service-manifest.py
          test -f config/service-update-manifest.schema.json
          test -f "$STAGE6_MANIFEST_PATH"
          test -s "$STAGE6_KNOWN_HOSTS"

          printf '%s  %s\n' \
            "$STAGE6_EXECUTOR_KEY_NORMALIZER_SHA256" \
            scripts/stage6-normalize-executor-key.sh | \
          sha256sum -c - >/dev/null

          git merge-base --is-ancestor "$STAGE6_FRAMEWORK_BASE_COMMIT" HEAD

          git diff --quiet "$STAGE6_FRAMEWORK_BASE_COMMIT" -- \
            ops/testserver/homelab-stage6-inspect \
            ops/testserver/homelab-stage6-inspector-ssh \
            ops/testserver/homelab-stage6-transition \
            ops/testserver/homelab-stage6-execute \
            ops/testserver/homelab-stage6-executor-ssh \
            ops/testserver/homelab-stage6-inspector-sudoers \
            ops/testserver/homelab-stage6-executor-sudoers \
            ops/ids01/homelab-stage6-inspector-ssh \
            ops/ids01/homelab-stage6-executor-ssh \
            ops/ids01/homelab-stage6-inspector-sudoers \
            ops/ids01/homelab-stage6-executor-sudoers \
            ops/ids01/homelab-stage6-inspector-authorized-key.template \
            ops/ids01/homelab-stage6-executor-authorized-key.template \
            config/service-update-manifest.schema.json \
            scripts/validate-stage6-service-manifest.py

          ssh-keygen \
            -lf "$STAGE6_KNOWN_HOSTS" \
            -E sha256 |
          awk '{print $2}' |
          grep -Fx "$STAGE6_HOSTKEY_FINGERPRINT" \
            >/dev/null

          install -d -m 0700 artifacts
          rm -f "${STAGE6_ARTIFACT_PREFIX}"-*.json \
                "${STAGE6_ARTIFACT_PREFIX}"-*.txt

          echo "PASS: generic Stage 6 source dependencies and $STAGE6_MANIFEST_HOST host key pinned"
        '''
      }
    }

    stage('Pre-approval inspection') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: env.STAGE6_INSPECTOR_CREDENTIAL,
            keyFileVariable: 'STAGE6_INSPECT_KEY',
            usernameVariable: 'STAGE6_INSPECT_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE6_INSPECT_USER" = "homelab-stage6-inspector" ]

            ssh \
              -n \
              -i "$STAGE6_INSPECT_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o PasswordAuthentication=no \
              -o KbdInteractiveAuthentication=no \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE6_KNOWN_HOSTS" \
              "$STAGE6_INSPECT_USER@$STAGE6_HOST" \
              "inspect $STAGE6_SERVICE" \
              </dev/null \
              > "${STAGE6_ARTIFACT_PREFIX}-inspection-before-approval.json"

            test -s "${STAGE6_ARTIFACT_PREFIX}-inspection-before-approval.json"
          '''
        }
      }
    }

    stage('Assert pre-approval artifact') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        script {
          def raw = readFile("${env.STAGE6_ARTIFACT_PREFIX}-inspection-before-approval.json")
          def a = new groovy.json.JsonSlurperClassic().parseText(raw)

          if (a.schema_version != 1 ||
              a.artifact != 'service-update-inspection' ||
              a.mode != 'stage6-preapproval-inspect' ||
              a.service != env.STAGE6_SERVICE ||
              a.host != env.STAGE6_MANIFEST_HOST ||
              a.result != 'ready-for-human-review') {
            error('Unexpected Stage 6 pre-approval inspection identity')
          }

          if (a.manifest_sha256 != env.STAGE6_MANIFEST_SHA256 ||
              a.implementation?.inspector_sha256 != env.STAGE6_INSPECTOR_SOURCE_SHA256) {
            error('Installed Stage 6 manifest/inspector does not match reviewed source')
          }

          if (a.authority?.revision != env.STAGE6_AUTHORITY_COMMIT ||
              a.authority?.compose_sha256 != env.STAGE6_COMPOSE_SHA256 ||
              a.authority?.live_matches_authority != true ||
              a.authority?.checkout_clean != true) {
            error('Stage 6 authority gate failed')
          }

          if (a.current?.state != 'rollback' ||
              a.current?.configured_image != env.STAGE6_ROLLBACK_CONFIGURED_IMAGE) {
            error('Current state is not the reviewed rollback baseline')
          }

          if (a.rollback?.version != env.STAGE6_ROLLBACK_VERSION ||
              a.rollback?.immutable_ref != env.STAGE6_ROLLBACK_REF ||
              a.rollback?.local_image_id != env.STAGE6_ROLLBACK_IMAGE_ID ||
              a.rollback?.platform != env.STAGE6_ROLLBACK_PLATFORM ||
              a.rollback?.local != true) {
            error('Stage 6 rollback identity/local platform gate failed')
          }

          if (a.candidate?.version != env.STAGE6_CANDIDATE_VERSION ||
              a.candidate?.immutable_ref != env.STAGE6_CANDIDATE_REF ||
              a.candidate?.local_image_id != env.STAGE6_CANDIDATE_IMAGE_ID ||
              a.candidate?.platform_manifest_digest != env.STAGE6_CANDIDATE_PLATFORM_MANIFEST ||
              a.candidate?.revision != env.STAGE6_CANDIDATE_REVISION ||
              a.candidate?.metadata_verification != env.STAGE6_CANDIDATE_METADATA_VERIFICATION ||
              a.candidate?.platform != env.STAGE6_CANDIDATE_PLATFORM ||
              a.candidate?.local != true) {
            error('Stage 6 candidate identity/local platform gate failed')
          }

          if (a.runtime?.invariants != 'pass' ||
              a.runtime?.health_strategy != env.STAGE6_HEALTH_STRATEGY ||
              a.runtime?.health_result != env.STAGE6_HEALTH_RESULT) {
            error('Stage 6 runtime/health gate failed')
          }

          if (a.approval?.required != true ||
              a.approval?.granted != false ||
              a.deployment?.allowed != false ||
              a.deployment?.performed != false) {
            error('Pre-approval authority state is not fail-closed')
          }

          def critical = [
            schema_version: a.schema_version,
            artifact: a.artifact,
            mode: a.mode,
            service: a.service,
            host: a.host,
            manifest_sha256: a.manifest_sha256,
            implementation: a.implementation,
            authority: a.authority,
            current: a.current,
            rollback: a.rollback,
            candidate: a.candidate,
            runtime: a.runtime,
            protected_state: a.protected_state,
            container_state: a.container_state,
            approval: a.approval,
            deployment: a.deployment,
            result: a.result
          ]

          writeFile(
            file: "${env.STAGE6_ARTIFACT_PREFIX}-critical-before-approval.json",
            text: groovy.json.JsonOutput.prettyPrint(
              groovy.json.JsonOutput.toJson(critical)
            ) + '\n'
          )

          echo("PASS: exact Stage 6 ${env.STAGE6_SERVICE} identities and deployment=false proven before approval")
        }
      }
    }

    stage('Human approval') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        script {
          timeout(time: 60, unit: 'MINUTES') {
            def approver = input(
              message: "Approve Stage 6 ${env.STAGE6_SERVICE} deployment?\n\n" +
                       "Update ID: ${env.STAGE6_UPDATE_ID}\n" +
                       "Current/Rollback: ${env.STAGE6_ROLLBACK_REF}\n" +
                       "Candidate: ${env.STAGE6_CANDIDATE_REF}\n" +
                       "No executor credential is bound until after a second read-only inspection proves zero drift.",
              ok: 'Approve exact Stage 6 deployment',
              submitter: 'james',
              submitterParameter: 'APPROVED_BY'
            )

            env.STAGE6_APPROVED_BY = approver.toString()
          }

          if (env.STAGE6_APPROVED_BY != 'james') {
            error('Stage 6 approval was not granted by the expected approver')
          }

          writeFile(
            file: "${env.STAGE6_ARTIFACT_PREFIX}-approval.txt",
            text: "approved_by=${env.STAGE6_APPROVED_BY}\nupdate_id=${env.STAGE6_UPDATE_ID}\nmanifest=${env.STAGE6_MANIFEST_PATH}\n"
          )

          echo("PASS: Stage 6 human approval granted by ${env.STAGE6_APPROVED_BY}")
        }
      }
    }

    stage('Re-inspect after approval') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: env.STAGE6_INSPECTOR_CREDENTIAL,
            keyFileVariable: 'STAGE6_REINSPECT_KEY',
            usernameVariable: 'STAGE6_REINSPECT_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE6_REINSPECT_USER" = "homelab-stage6-inspector" ]

            ssh \
              -n \
              -i "$STAGE6_REINSPECT_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o PasswordAuthentication=no \
              -o KbdInteractiveAuthentication=no \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE6_KNOWN_HOSTS" \
              "$STAGE6_REINSPECT_USER@$STAGE6_HOST" \
              "inspect $STAGE6_SERVICE" \
              </dev/null \
              > "${STAGE6_ARTIFACT_PREFIX}-inspection-after-approval.json"

            test -s "${STAGE6_ARTIFACT_PREFIX}-inspection-after-approval.json"
          '''
        }
      }
    }

    stage('Assert zero drift after approval') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        script {
          def beforeRaw = readFile("${env.STAGE6_ARTIFACT_PREFIX}-critical-before-approval.json")
          def before = new groovy.json.JsonSlurperClassic().parseText(beforeRaw)
          def raw = readFile("${env.STAGE6_ARTIFACT_PREFIX}-inspection-after-approval.json")
          def a = new groovy.json.JsonSlurperClassic().parseText(raw)

          if (a.schema_version != 1 ||
              a.artifact != 'service-update-inspection' ||
              a.mode != 'stage6-preapproval-inspect' ||
              a.service != env.STAGE6_SERVICE ||
              a.host != env.STAGE6_MANIFEST_HOST ||
              a.result != 'ready-for-human-review') {
            error('Post-approval inspection identity changed')
          }

          if (a.approval?.required != true ||
              a.approval?.granted != false ||
              a.deployment?.allowed != false ||
              a.deployment?.performed != false) {
            error('Deployment authority appeared before executor binding')
          }

          def after = [
            schema_version: a.schema_version,
            artifact: a.artifact,
            mode: a.mode,
            service: a.service,
            host: a.host,
            manifest_sha256: a.manifest_sha256,
            implementation: a.implementation,
            authority: a.authority,
            current: a.current,
            rollback: a.rollback,
            candidate: a.candidate,
            runtime: a.runtime,
            protected_state: a.protected_state,
            container_state: a.container_state,
            approval: a.approval,
            deployment: a.deployment,
            result: a.result
          ]

          writeFile(
            file: "${env.STAGE6_ARTIFACT_PREFIX}-critical-after-approval.json",
            text: groovy.json.JsonOutput.prettyPrint(
              groovy.json.JsonOutput.toJson(after)
            ) + '\n'
          )

          if (before != after) {
            error('Critical Stage 6 state drifted between inspection and approval')
          }

          echo('PASS: second Stage 6 inspection exactly matches pre-approval critical state')
        }
      }
    }

    stage('Executor preflight after approval') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: env.STAGE6_EXECUTOR_CREDENTIAL,
            keyFileVariable: 'STAGE6_EXECUTOR_PING_KEY',
            usernameVariable: 'STAGE6_EXECUTOR_PING_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE6_EXECUTOR_PING_USER" = "homelab-stage6-executor" ]

            NORMALIZED_EXECUTOR_KEY="$(mktemp "${WORKSPACE}/.stage6-executor-key.XXXXXX")"
            trap 'rm -f "$NORMALIZED_EXECUTOR_KEY"' EXIT HUP INT TERM
            scripts/stage6-normalize-executor-key.sh \
              "$STAGE6_EXECUTOR_PING_KEY" \
              "$NORMALIZED_EXECUTOR_KEY" \
              "$STAGE6_EXECUTOR_FINGERPRINT" \
              > "${STAGE6_ARTIFACT_PREFIX}-executor-ping-key-validation.txt"

            ssh \
              -n \
              -i "$NORMALIZED_EXECUTOR_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o PasswordAuthentication=no \
              -o KbdInteractiveAuthentication=no \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE6_KNOWN_HOSTS" \
              "$STAGE6_EXECUTOR_PING_USER@$STAGE6_HOST" \
              ping \
              </dev/null \
              > "${STAGE6_ARTIFACT_PREFIX}-executor-ping.txt"

            grep -Fx 'pong' "${STAGE6_ARTIFACT_PREFIX}-executor-ping.txt" >/dev/null
          '''
        }

        echo('PASS: executor credential reachable only after approval and zero-drift reinspection')
      }
    }

    stage('Arm exact update') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: env.STAGE6_EXECUTOR_CREDENTIAL,
            keyFileVariable: 'STAGE6_ARM_KEY',
            usernameVariable: 'STAGE6_ARM_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE6_ARM_USER" = "homelab-stage6-executor" ]

            NORMALIZED_EXECUTOR_KEY="$(mktemp "${WORKSPACE}/.stage6-executor-key.XXXXXX")"
            trap 'rm -f "$NORMALIZED_EXECUTOR_KEY"' EXIT HUP INT TERM
            scripts/stage6-normalize-executor-key.sh \
              "$STAGE6_ARM_KEY" \
              "$NORMALIZED_EXECUTOR_KEY" \
              "$STAGE6_EXECUTOR_FINGERPRINT" \
              > "${STAGE6_ARTIFACT_PREFIX}-arm-key-validation.txt"

            ssh \
              -n \
              -i "$NORMALIZED_EXECUTOR_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o PasswordAuthentication=no \
              -o KbdInteractiveAuthentication=no \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE6_KNOWN_HOSTS" \
              "$STAGE6_ARM_USER@$STAGE6_HOST" \
              "arm $STAGE6_SERVICE" \
              </dev/null \
              > "${STAGE6_ARTIFACT_PREFIX}-arm.json"

            test -s "${STAGE6_ARTIFACT_PREFIX}-arm.json"
          '''
        }

        script {
          def raw = readFile("${env.STAGE6_ARTIFACT_PREFIX}-arm.json")
          def a = new groovy.json.JsonSlurperClassic().parseText(raw)

          if (a.schema_version != 1 ||
              a.artifact != 'stage6-transition' ||
              a.action != 'arm' ||
              a.service != env.STAGE6_SERVICE ||
              a.update_id != env.STAGE6_UPDATE_ID ||
              a.rollback?.version != env.STAGE6_ROLLBACK_VERSION ||
              a.rollback?.immutable_ref != env.STAGE6_ROLLBACK_REF ||
              a.candidate?.version != env.STAGE6_CANDIDATE_VERSION ||
              a.candidate?.immutable_ref != env.STAGE6_CANDIDATE_REF ||
              a.container_mutation_performed != false ||
              a.deployment_authority != true ||
              a.result != 'armed') {
            error('Stage 6 arm artifact failed exact assertions')
          }

          echo("PASS: exact Stage 6 ${env.STAGE6_SERVICE} update armed after approval and zero-drift recheck")
        }
      }
    }

    stage('Deploy exact candidate') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        script {
          int rc = 99

          withCredentials([
            sshUserPrivateKey(
              credentialsId: env.STAGE6_EXECUTOR_CREDENTIAL,
              keyFileVariable: 'STAGE6_DEPLOY_KEY',
              usernameVariable: 'STAGE6_DEPLOY_USER'
            )
          ]) {
            rc = sh(
              returnStatus: true,
              script: '''
                set +x

                [ "$STAGE6_DEPLOY_USER" = "homelab-stage6-executor" ] || exit 97

                NORMALIZED_EXECUTOR_KEY="$(mktemp "${WORKSPACE}/.stage6-executor-key.XXXXXX")" || exit 96
                trap 'rm -f "$NORMALIZED_EXECUTOR_KEY"' EXIT HUP INT TERM
                scripts/stage6-normalize-executor-key.sh \
                  "$STAGE6_DEPLOY_KEY" \
                  "$NORMALIZED_EXECUTOR_KEY" \
                  "$STAGE6_EXECUTOR_FINGERPRINT" \
                  > "${STAGE6_ARTIFACT_PREFIX}-deploy-key-validation.txt" || exit 96

                ssh \
                  -n \
                  -i "$NORMALIZED_EXECUTOR_KEY" \
                  -o IdentitiesOnly=yes \
                  -o BatchMode=yes \
                  -o PasswordAuthentication=no \
                  -o KbdInteractiveAuthentication=no \
                  -o ConnectTimeout=10 \
                  -o StrictHostKeyChecking=yes \
                  -o UserKnownHostsFile="$STAGE6_KNOWN_HOSTS" \
                  "$STAGE6_DEPLOY_USER@$STAGE6_HOST" \
                  "deploy $STAGE6_SERVICE" \
                  </dev/null \
                  > "${STAGE6_ARTIFACT_PREFIX}-deploy.json" \
                  2> "${STAGE6_ARTIFACT_PREFIX}-deploy-error.txt"
              '''
            )
          }

          env.STAGE6_DEPLOY_RC = rc.toString()

          if (rc == 96 || rc == 97) {
            error(
              "Stage 6 deploy was not attempted because the local executor " +
              "credential gate failed with rc=${rc}. The update may remain " +
              "armed, but the candidate is unconsumed because deploy SSH was " +
              "never invoked. Rollback must not be attempted; controlled " +
              "recovery only."
            )
          }

          if (rc == 0) {
            def raw = readFile("${env.STAGE6_ARTIFACT_PREFIX}-deploy.json")
            def a = new groovy.json.JsonSlurperClassic().parseText(raw)

            if (a.schema_version != 1 ||
                a.artifact != 'stage6-execution-result' ||
                a.action != 'deploy' ||
                a.service != env.STAGE6_SERVICE ||
                a.update_id != env.STAGE6_UPDATE_ID ||
                a.rollback?.version != env.STAGE6_ROLLBACK_VERSION ||
                a.rollback?.immutable_ref != env.STAGE6_ROLLBACK_REF ||
                a.candidate?.version != env.STAGE6_CANDIDATE_VERSION ||
                a.candidate?.immutable_ref != env.STAGE6_CANDIDATE_REF ||
                a.health_result != env.STAGE6_HEALTH_RESULT ||
                a.container_mutation_performed != true ||
                a.unrelated_containers_unchanged != true ||
                a.consumed != true ||
                a.deployment_authority_remains_armed != true ||
                a.result != 'deployed') {
              error('Stage 6 deploy artifact failed exact assertions')
            }

            if (!(a.target?.container_id_before instanceof String) ||
                !(a.target?.container_id_after instanceof String) ||
                a.target.container_id_before == a.target.container_id_after) {
              error('Stage 6 deploy target container identity did not change as expected')
            }

            echo("PASS: exact ${env.STAGE6_SERVICE} candidate deployed and host-side invariants passed")
          } else {
            echo("Stage 6 deploy command failed with rc=${rc}; reviewed rollback path will be attempted")
          }
        }
      }
    }

    stage('Rollback on deploy failure') {
      when {
        expression {
          return env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE' &&
                 env.STAGE6_DEPLOY_RC != null &&
                 env.STAGE6_DEPLOY_RC != '0' &&
                 env.STAGE6_DEPLOY_RC != '96' &&
                 env.STAGE6_DEPLOY_RC != '97'
        }
      }
      steps {
        script {
          int rollbackRc = 99

          withCredentials([
            sshUserPrivateKey(
              credentialsId: env.STAGE6_EXECUTOR_CREDENTIAL,
              keyFileVariable: 'STAGE6_ROLLBACK_KEY',
              usernameVariable: 'STAGE6_ROLLBACK_USER'
            )
          ]) {
            rollbackRc = sh(
              returnStatus: true,
              script: '''
                set +x

                [ "$STAGE6_ROLLBACK_USER" = "homelab-stage6-executor" ] || exit 97

                NORMALIZED_EXECUTOR_KEY="$(mktemp "${WORKSPACE}/.stage6-executor-key.XXXXXX")" || exit 96
                trap 'rm -f "$NORMALIZED_EXECUTOR_KEY"' EXIT HUP INT TERM
                scripts/stage6-normalize-executor-key.sh \
                  "$STAGE6_ROLLBACK_KEY" \
                  "$NORMALIZED_EXECUTOR_KEY" \
                  "$STAGE6_EXECUTOR_FINGERPRINT" \
                  > "${STAGE6_ARTIFACT_PREFIX}-rollback-key-validation.txt" || exit 96

                ssh \
                  -n \
                  -i "$NORMALIZED_EXECUTOR_KEY" \
                  -o IdentitiesOnly=yes \
                  -o BatchMode=yes \
                  -o PasswordAuthentication=no \
                  -o KbdInteractiveAuthentication=no \
                  -o ConnectTimeout=10 \
                  -o StrictHostKeyChecking=yes \
                  -o UserKnownHostsFile="$STAGE6_KNOWN_HOSTS" \
                  "$STAGE6_ROLLBACK_USER@$STAGE6_HOST" \
                  "rollback $STAGE6_SERVICE" \
                  </dev/null \
                  > "${STAGE6_ARTIFACT_PREFIX}-rollback.json" \
                  2> "${STAGE6_ARTIFACT_PREFIX}-rollback-error.txt"
              '''
            )
          }

          env.STAGE6_ROLLBACK_RC = rollbackRc.toString()

          if (rollbackRc != 0) {
            error(
              'Stage 6 deploy failed and reviewed rollback did not succeed. ' +
              'Execution remains armed/consumed for controlled manual recovery; no improvised Docker action is permitted.'
            )
          }

          def raw = readFile("${env.STAGE6_ARTIFACT_PREFIX}-rollback.json")
          def a = new groovy.json.JsonSlurperClassic().parseText(raw)

          if (a.schema_version != 1 ||
              a.artifact != 'stage6-execution-result' ||
              a.action != 'rollback' ||
              a.service != env.STAGE6_SERVICE ||
              a.update_id != env.STAGE6_UPDATE_ID ||
              a.rollback?.version != env.STAGE6_ROLLBACK_VERSION ||
              a.rollback?.immutable_ref != env.STAGE6_ROLLBACK_REF ||
              a.candidate?.version != env.STAGE6_CANDIDATE_VERSION ||
              a.candidate?.immutable_ref != env.STAGE6_CANDIDATE_REF ||
              a.health_result != env.STAGE6_HEALTH_RESULT ||
              a.container_mutation_performed != true ||
              a.unrelated_containers_unchanged != true ||
              a.consumed != true ||
              a.deployment_authority_remains_armed != true ||
              a.result != 'rolled-back') {
            error('Stage 6 rollback artifact failed exact assertions')
          }

          if (!(a.target?.container_id_before instanceof String) ||
              !(a.target?.container_id_after instanceof String) ||
              a.target.container_id_before == a.target.container_id_after) {
            error('Stage 6 rollback target container identity did not change as expected')
          }

          echo("PASS: reviewed rollback restored exact ${env.STAGE6_SERVICE} rollback identity")
        }
      }
    }

    stage('Disarm terminal state') {
      when {
        expression {
          return env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE' &&
                 (env.STAGE6_DEPLOY_RC == '0' || env.STAGE6_ROLLBACK_RC == '0')
        }
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: env.STAGE6_EXECUTOR_CREDENTIAL,
            keyFileVariable: 'STAGE6_DISARM_KEY',
            usernameVariable: 'STAGE6_DISARM_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE6_DISARM_USER" = "homelab-stage6-executor" ]

            NORMALIZED_EXECUTOR_KEY="$(mktemp "${WORKSPACE}/.stage6-executor-key.XXXXXX")"
            trap 'rm -f "$NORMALIZED_EXECUTOR_KEY"' EXIT HUP INT TERM
            scripts/stage6-normalize-executor-key.sh \
              "$STAGE6_DISARM_KEY" \
              "$NORMALIZED_EXECUTOR_KEY" \
              "$STAGE6_EXECUTOR_FINGERPRINT" \
              > "${STAGE6_ARTIFACT_PREFIX}-disarm-key-validation.txt"

            ssh \
              -n \
              -i "$NORMALIZED_EXECUTOR_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o PasswordAuthentication=no \
              -o KbdInteractiveAuthentication=no \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE6_KNOWN_HOSTS" \
              "$STAGE6_DISARM_USER@$STAGE6_HOST" \
              "disarm $STAGE6_SERVICE" \
              </dev/null \
              > "${STAGE6_ARTIFACT_PREFIX}-disarm.json"

            test -s "${STAGE6_ARTIFACT_PREFIX}-disarm.json"
          '''
        }

        script {
          def raw = readFile("${env.STAGE6_ARTIFACT_PREFIX}-disarm.json")
          def a = new groovy.json.JsonSlurperClassic().parseText(raw)

          if (a.schema_version != 1 ||
              a.artifact != 'stage6-transition' ||
              a.action != 'disarm' ||
              a.service != env.STAGE6_SERVICE ||
              a.update_id != env.STAGE6_UPDATE_ID ||
              a.consumed != true ||
              a.container_mutation_performed != false ||
              a.deployment_authority != false ||
              a.result != 'disarmed') {
            error('Stage 6 disarm artifact failed exact assertions')
          }

          echo('PASS: one-shot Stage 6 execution authority disarmed')
        }
      }
    }

    stage('Final pipeline result') {
      when {
        expression {
          env.STAGE6_MANIFEST_PREPARED != 'true' && params.STAGE6_ACTION == 'UPDATE'
        }
      }
      steps {
        script {
          if (env.STAGE6_DEPLOY_RC == '0') {
            echo("STAGE 6 ${env.STAGE6_SERVICE} RESULT: DEPLOYED EXACT CANDIDATE AND DISARMED")
          } else if (env.STAGE6_ROLLBACK_RC == '0') {
            currentBuild.result = 'FAILURE'
            echo("STAGE 6 ${env.STAGE6_SERVICE} RESULT: DEPLOY FAILED, EXACT ROLLBACK RESTORED AND DISARMED")
          } else {
            error('Stage 6 terminal state is unresolved')
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts(
        artifacts: 'artifacts/**',
        allowEmptyArchive: true,
        fingerprint: true
      )
    }
  }
}
