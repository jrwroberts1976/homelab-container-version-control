{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jrwroberts1976/homelab-container-version-control/config/service-image-normalization-manifest.schema.json",
  "title": "Stage 6 Same-Content Image Reference Normalization Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "mode",
    "service",
    "authority",
    "image",
    "runtime",
    "health",
    "protection",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "const": "service-image-normalization-manifest"
    },
    "mode": {
      "const": "stage6-image-ref-normalization"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "container",
        "host",
        "image_type",
        "risk_class",
        "compose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "enum": [
            "TestServer",
            "ids-01"
          ]
        },
        "image_type": {
          "const": "registry-image"
        },
        "risk_class": {
          "enum": [
            "low",
            "medium"
          ]
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "service",
            "project_directory",
            "compose_file",
            "image_variable"
          ],
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "string",
              "minLength": 1
            },
            "project_directory": {
              "type": "string",
              "pattern": "^/"
            },
            "compose_file": {
              "type": "string",
              "pattern": "^/"
            },
            "image_variable": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "compose_sha256"
      ],
      "properties": {
        "repository": {
          "const": "docker-env"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "compose_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compose_path": {
          "type": "string",
          "pattern": "^(?:stacks|hosts/[A-Za-z0-9.-]+)/[A-Za-z0-9._/-]+$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "repository",
        "source",
        "target",
        "rollback",
        "platform",
        "same_content_required"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/taggedImage"
        },
        "target": {
          "$ref": "#/$defs/immutableImage"
        },
        "rollback": {
          "$ref": "#/$defs/taggedImage"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "same_content_required": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networks",
        "published_ports",
        "mounts",
        "user",
        "privileged",
        "readonly_rootfs",
        "restart_policy",
        "devices_allowed",
        "docker_socket_allowed",
        "compose_execution"
      ],
      "properties": {
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "published_ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host_ip",
              "host_port",
              "container_port",
              "protocol"
            ],
            "properties": {
              "host_ip": {
                "type": "string",
                "minLength": 1
              },
              "host_port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "container_port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "enum": [
                  "tcp",
                  "udp"
                ]
              }
            }
          }
        },
        "mounts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "source",
              "destination",
              "rw",
              "sha256"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bind",
                  "volume"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "pattern": "^/"
              },
              "rw": {
                "type": "boolean"
              },
              "source_kind": {
                "enum": [
                  "file",
                  "directory"
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "user": {
          "type": "string"
        },
        "privileged": {
          "const": false
        },
        "readonly_rootfs": {
          "type": "boolean"
        },
        "restart_policy": {
          "type": "string",
          "minLength": 1
        },
        "devices_allowed": {
          "const": false
        },
        "docker_socket_allowed": {
          "const": false
        },
        "compose_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "no_deps",
            "no_build",
            "pull",
            "force_recreate"
          ],
          "properties": {
            "no_deps": {
              "const": true
            },
            "no_build": {
              "const": true
            },
            "pull": {
              "const": "never"
            },
            "force_recreate": {
              "const": true
            }
          }
        }
      }
    },
    "health": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "url",
            "expected_status",
            "marker",
            "timeout_seconds"
          ],
          "properties": {
            "strategy": {
              "const": "http"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "expected_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "marker": {
              "type": [
                "string",
                "null"
              ]
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "network",
            "container_port",
            "path",
            "expected_status",
            "marker",
            "timeout_seconds"
          ],
          "properties": {
            "strategy": {
              "const": "container-http"
            },
            "network": {
              "type": "string",
              "minLength": 1
            },
            "container_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "expected_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "marker": {
              "type": [
                "string",
                "null"
              ]
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            }
          }
        }
      ]
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containers",
        "compare",
        "all_other_containers_unchanged"
      ],
      "properties": {
        "containers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compare": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "container_id",
              "restart_count"
            ]
          }
        },
        "all_other_containers_unchanged": {
          "const": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_approval_required",
        "post_approval_reinspection_required",
        "one_shot_required",
        "target_must_be_local_before_arm",
        "deployment_pull_allowed",
        "rollback_required",
        "rollback_ref_type",
        "normalization_kind"
      ],
      "properties": {
        "human_approval_required": {
          "const": true
        },
        "post_approval_reinspection_required": {
          "const": true
        },
        "one_shot_required": {
          "const": true
        },
        "target_must_be_local_before_arm": {
          "const": true
        },
        "deployment_pull_allowed": {
          "const": false
        },
        "rollback_required": {
          "const": true
        },
        "rollback_ref_type": {
          "const": "tagged-source-configuration"
        },
        "normalization_kind": {
          "const": "tag-to-immutable-same-content"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "arm64",
            "amd64"
          ]
        }
      }
    },
    "taggedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_image",
        "local_image_id"
      ],
      "properties": {
        "configured_image": {
          "type": "string",
          "minLength": 1
        },
        "local_image_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "immutableImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_image",
        "index_digest",
        "local_image_id"
      ],
      "properties": {
        "configured_image": {
          "type": "string",
          "minLength": 1
        },
        "index_digest": {
          "$ref": "#/$defs/digest"
        },
        "local_image_id": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
