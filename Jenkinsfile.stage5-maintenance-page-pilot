pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
  }

  environment {
    STAGE5_HOST = '172.30.255.249'
    STAGE5_KNOWN_HOSTS = '/var/jenkins_home/.ssh/stage4-testserver-known_hosts'
    STAGE5_HOSTKEY_FINGERPRINT = 'SHA256:PEDpP7QlmSztJSIYHzZ+YuIT7XurmpeWp85wRnlfZuk'

    STAGE5_PILOT_ID = 'stage5-maintenance-page-nginx-1.31.4-20260827'
    STAGE5_SERVICE = 'maintenance-page'
    STAGE5_AUTHORITY_COMMIT = 'f0430e1d9ee91ba4dfba7db34d0e9f0e201a8883'

    STAGE5_ROLLBACK = 'nginx@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752'
    STAGE5_CANDIDATE = 'nginx@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913'
    STAGE5_CANDIDATE_IMAGE_ID = 'sha256:c961b530972080b857d1f447363cc411023cf31727e06e14aba0f76cebee6aa5'
    STAGE5_ROLLBACK_IMAGE_ID = 'sha256:28c4e91555d001bb0f6b2796e565bfa75302711a0d6e67c5562eb2f7d54d2483'
    STAGE5_EXECUTION_POLICY_SHA256 = 'e8c629e34d16a02b2dc9a979dbe50da47dace810875bbc3296cead6285af2bc5'

    STAGE5_CORE_SOURCE_COMMIT = 'a7fb8258b2d7a401e4bb494846b8a764e95aa0fc'
    STAGE5_GATE_SHA256 = '561499a0e327f02e4df7fdabf40ab1d0660dc5ed51622061c568f9deaaa4dbda'
    STAGE5_INSPECTOR_SHA256 = '64dc6526e66a9e6878ca23c1703a9d7bb11c82b7f60cf7b8aae714b2ed9cb213'
    STAGE5_HELPER_SHA256 = 'a0df7b46aa01ffc9ef3fbf43cea43caeef34681ef22b759ae822ed2832cfc42a'
    STAGE5_TRANSITION_SHA256 = '73eb78453b87e86760cb9fafd556e11c2a5c43c8df2b2d3e87fa0429902d64d1'
    STAGE5_EXECUTOR_WRAPPER_SHA256 = '2feea261deaccb92dccc1f9c982ed9f4360c6320ad84dba2d7b39e476582dc49'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Source and host-key preflight') {
      steps {
        sh '''
          set -eu

          test -f ops/testserver/homelab-stage5-maintenance-page-authority-gate
          test -f ops/testserver/homelab-stage5-maintenance-page-inspect
          test -f ops/testserver/homelab-stage5-maintenance-page-helper
          test -f ops/testserver/homelab-stage5-maintenance-page-transition
          test -f ops/testserver/homelab-stage5-executor-ssh
          test -f config/stage5-maintenance-page-execution-enabled.template.json
          test -s "$STAGE5_KNOWN_HOSTS"

          git merge-base --is-ancestor "$STAGE5_CORE_SOURCE_COMMIT" HEAD

          check_sha() {
            file="$1"
            expected="$2"
            actual="$(sha256sum "$file" | awk '{print $1}')"
            [ "$actual" = "$expected" ] || {
              echo "ERROR: reviewed source hash mismatch: $file" >&2
              exit 2
            }
          }

          check_sha \
            ops/testserver/homelab-stage5-maintenance-page-authority-gate \
            "$STAGE5_GATE_SHA256"

          check_sha \
            ops/testserver/homelab-stage5-maintenance-page-inspect \
            "$STAGE5_INSPECTOR_SHA256"

          check_sha \
            ops/testserver/homelab-stage5-maintenance-page-helper \
            "$STAGE5_HELPER_SHA256"

          check_sha \
            ops/testserver/homelab-stage5-maintenance-page-transition \
            "$STAGE5_TRANSITION_SHA256"

          check_sha \
            ops/testserver/homelab-stage5-executor-ssh \
            "$STAGE5_EXECUTOR_WRAPPER_SHA256"

          check_sha \
            config/stage5-maintenance-page-execution-enabled.template.json \
            "$STAGE5_EXECUTION_POLICY_SHA256"

          ssh-keygen \
            -lf "$STAGE5_KNOWN_HOSTS" \
            -E sha256 |
          awk '{print $2}' |
          grep -Fx "$STAGE5_HOSTKEY_FINGERPRINT" \
            >/dev/null

          install -d -m 0700 artifacts
          rm -f artifacts/stage5-*.json artifacts/stage5-*.txt

          echo "PASS: Stage 5 source identities and TestServer host key pinned"
        '''
      }
    }

    stage('Pre-approval inspection') {
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'homelab-stage5-testserver-inspector',
            keyFileVariable: 'STAGE5_INSPECT_KEY',
            usernameVariable: 'STAGE5_INSPECT_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE5_INSPECT_USER" = "homelab-stage5-pilot" ]

            ssh \
              -i "$STAGE5_INSPECT_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE5_KNOWN_HOSTS" \
              "$STAGE5_INSPECT_USER@$STAGE5_HOST" \
              "inspect maintenance-page" \
              > artifacts/stage5-inspection-before-approval.json

            test -s artifacts/stage5-inspection-before-approval.json
          '''
        }
      }
    }

    stage('Assert pre-approval artifact') {
      steps {
        script {
          def raw = readFile('artifacts/stage5-inspection-before-approval.json')
          def a = new groovy.json.JsonSlurperClassic().parseText(raw)

          if (a.schema_version != 1 || a.mode != 'stage5-preapproval-inspect') {
            error('Unexpected Stage 5 inspection schema/mode')
          }
          if (a.artifact != 'pilot-inspection' || a.pilot_id != env.STAGE5_PILOT_ID) {
            error('Unexpected Stage 5 pilot inspection identity')
          }
          if (a.service != env.STAGE5_SERVICE || a.host != 'TestServer') {
            error('Unexpected Stage 5 service/host')
          }
          if (a.authority?.docker_env_commit != env.STAGE5_AUTHORITY_COMMIT) {
            error('Unexpected docker-env authority commit')
          }
          if (a.current?.immutable_digest != env.STAGE5_ROLLBACK) {
            error('Current runtime is not exact rollback baseline')
          }
          if (a.candidate?.immutable_digest != env.STAGE5_CANDIDATE ||
              a.candidate?.image_id != env.STAGE5_CANDIDATE_IMAGE_ID ||
              a.candidate?.platform != 'linux/arm64' ||
              a.candidate?.local != true) {
            error('Candidate identity/local ARM64 gate failed')
          }
          if (a.rollback?.immutable_digest != env.STAGE5_ROLLBACK ||
              a.rollback?.image_id != env.STAGE5_ROLLBACK_IMAGE_ID ||
              a.rollback?.platform != 'linux/arm64' ||
              a.rollback?.local != true) {
            error('Rollback identity/local ARM64 gate failed')
          }
          if (a.runtime?.health_result != 'pass') {
            error('Pre-approval health gate failed')
          }
          if (a.approval?.required != true || a.approval?.granted != false) {
            error('Inspection artifact approval state is unexpected')
          }
          if (a.inspection?.allowed != true || a.inspection?.performed != true) {
            error('Inspection contract failed')
          }
          if (a.deployment?.allowed != false ||
              a.deployment?.performed != false ||
              a.deployment?.deploy_command_enabled != false ||
              a.deployment?.rollback_command_enabled != false) {
            error('Pre-approval artifact unexpectedly permits deployment')
          }
          if (a.result != 'ready-for-human-review') {
            error('Stage 5 inspection is not ready for human review')
          }

          def critical = [
            schema_version: a.schema_version,
            pilot_id: a.pilot_id,
            service: a.service,
            host: a.host,
            authority_commit: a.authority.docker_env_commit,
            current_digest: a.current.immutable_digest,
            current_container_id: a.current.container_id,
            current_restart_count: a.current.restart_count,
            candidate_digest: a.candidate.immutable_digest,
            candidate_image_id: a.candidate.image_id,
            candidate_platform: a.candidate.platform,
            rollback_digest: a.rollback.immutable_digest,
            rollback_image_id: a.rollback.image_id,
            rollback_platform: a.rollback.platform,
            network: a.runtime.network,
            host_ip: a.runtime.host_ip,
            host_port: a.runtime.host_port,
            health_url: a.runtime.health_url,
            health_marker: a.runtime.health_marker,
            health_result: a.runtime.health_result,
            jenkins_container_id: a.protected_state.jenkins.container_id,
            jenkins_restart_count: a.protected_state.jenkins.restart_count,
            dind_container_id: a.protected_state.jenkins_docker.container_id,
            dind_restart_count: a.protected_state.jenkins_docker.restart_count
          ]

          writeFile(
            file: 'artifacts/stage5-critical-before-approval.json',
            text: groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(critical)) + '\n'
          )

          echo('PASS: exact pilot identities and deployment.allowed=false proven before approval')
        }
      }
    }

    stage('Human approval') {
      steps {
        script {
          timeout(time: 60, unit: 'MINUTES') {
            def approver = input(
              message: "Approve Stage 5 maintenance-page deployment?\n\n" +
                       "Pilot: ${env.STAGE5_PILOT_ID}\n" +
                       "Current/Rollback: ${env.STAGE5_ROLLBACK}\n" +
                       "Candidate: ${env.STAGE5_CANDIDATE}\n" +
                       "Only the reviewed maintenance-page one-shot path will be enabled.",
              ok: 'Approve exact deployment',
              submitter: 'james',
              submitterParameter: 'APPROVED_BY'
            )

            env.STAGE5_APPROVED_BY = approver.toString()
          }

          if (env.STAGE5_APPROVED_BY != 'james') {
            error('Stage 5 approval was not granted by the expected approver')
          }

          writeFile(
            file: 'artifacts/stage5-approval.txt',
            text: "approved_by=${env.STAGE5_APPROVED_BY}\npilot_id=${env.STAGE5_PILOT_ID}\n"
          )

          echo("PASS: human approval granted by ${env.STAGE5_APPROVED_BY}")
        }
      }
    }

    stage('Re-inspect after approval') {
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'homelab-stage5-testserver-inspector',
            keyFileVariable: 'STAGE5_REINSPECT_KEY',
            usernameVariable: 'STAGE5_REINSPECT_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE5_REINSPECT_USER" = "homelab-stage5-pilot" ]

            ssh \
              -i "$STAGE5_REINSPECT_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE5_KNOWN_HOSTS" \
              "$STAGE5_REINSPECT_USER@$STAGE5_HOST" \
              "inspect maintenance-page" \
              > artifacts/stage5-inspection-after-approval.json

            test -s artifacts/stage5-inspection-after-approval.json
          '''
        }
      }
    }

    stage('Assert no drift after approval') {
      steps {
        script {
          def before = new groovy.json.JsonSlurperClassic().parseText(
            readFile('artifacts/stage5-critical-before-approval.json')
          )
          def raw = readFile('artifacts/stage5-inspection-after-approval.json')
          def a = new groovy.json.JsonSlurperClassic().parseText(raw)

          if (a.schema_version != 1 || a.mode != 'stage5-preapproval-inspect' ||
              a.artifact != 'pilot-inspection' || a.pilot_id != env.STAGE5_PILOT_ID ||
              a.service != env.STAGE5_SERVICE || a.host != 'TestServer') {
            error('Post-approval inspection identity changed')
          }
          if (a.current?.immutable_digest != env.STAGE5_ROLLBACK ||
              a.candidate?.immutable_digest != env.STAGE5_CANDIDATE ||
              a.rollback?.immutable_digest != env.STAGE5_ROLLBACK ||
              a.runtime?.health_result != 'pass') {
            error('Post-approval runtime/image/health gate failed')
          }
          if (a.deployment?.allowed != false || a.deployment?.performed != false ||
              a.deployment?.deploy_command_enabled != false ||
              a.deployment?.rollback_command_enabled != false) {
            error('Deployment authority appeared before executor binding')
          }

          def after = [
            schema_version: a.schema_version,
            pilot_id: a.pilot_id,
            service: a.service,
            host: a.host,
            authority_commit: a.authority.docker_env_commit,
            current_digest: a.current.immutable_digest,
            current_container_id: a.current.container_id,
            current_restart_count: a.current.restart_count,
            candidate_digest: a.candidate.immutable_digest,
            candidate_image_id: a.candidate.image_id,
            candidate_platform: a.candidate.platform,
            rollback_digest: a.rollback.immutable_digest,
            rollback_image_id: a.rollback.image_id,
            rollback_platform: a.rollback.platform,
            network: a.runtime.network,
            host_ip: a.runtime.host_ip,
            host_port: a.runtime.host_port,
            health_url: a.runtime.health_url,
            health_marker: a.runtime.health_marker,
            health_result: a.runtime.health_result,
            jenkins_container_id: a.protected_state.jenkins.container_id,
            jenkins_restart_count: a.protected_state.jenkins.restart_count,
            dind_container_id: a.protected_state.jenkins_docker.container_id,
            dind_restart_count: a.protected_state.jenkins_docker.restart_count
          ]

          if (before != after) {
            writeFile(
              file: 'artifacts/stage5-critical-after-approval.json',
              text: groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(after)) + '\n'
            )
            error('Critical Stage 5 state drifted between inspection and approval')
          }

          writeFile(
            file: 'artifacts/stage5-critical-after-approval.json',
            text: groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(after)) + '\n'
          )

          echo('PASS: second inspection exactly matches pre-approval critical state')
        }
      }
    }

    stage('Arm exact pilot') {
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'homelab-stage5-testserver-executor',
            keyFileVariable: 'STAGE5_EXECUTOR_KEY',
            usernameVariable: 'STAGE5_EXECUTOR_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            [ "$STAGE5_EXECUTOR_USER" = "homelab-stage5-executor" ]

            ssh \
              -i "$STAGE5_EXECUTOR_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE5_KNOWN_HOSTS" \
              "$STAGE5_EXECUTOR_USER@$STAGE5_HOST" \
              "arm maintenance-page" \
              > artifacts/stage5-arm.json

            test -s artifacts/stage5-arm.json
          '''
        }

        script {
          def a = new groovy.json.JsonSlurperClassic().parseText(readFile('artifacts/stage5-arm.json'))

          if (a.schema_version != 1 || a.mode != 'stage5-execution-transition' ||
              a.action != 'arm' || a.pilot_id != env.STAGE5_PILOT_ID ||
              a.service != env.STAGE5_SERVICE ||
              a.execution_policy_sha256 != env.STAGE5_EXECUTION_POLICY_SHA256 ||
              a.deployment?.activated != true || a.deployment?.performed != false ||
              a.result != 'armed') {
            error('Stage 5 arm artifact failed exact assertions')
          }

          echo('PASS: exact pilot armed after approval and drift recheck')
        }
      }
    }

    stage('Deploy exact candidate') {
      steps {
        script {
          int rc = 99

          withCredentials([
            sshUserPrivateKey(
              credentialsId: 'homelab-stage5-testserver-executor',
              keyFileVariable: 'STAGE5_DEPLOY_KEY',
              usernameVariable: 'STAGE5_DEPLOY_USER'
            )
          ]) {
            rc = sh(
              returnStatus: true,
              script: '''
                set +x

                ssh \
                  -i "$STAGE5_DEPLOY_KEY" \
                  -o IdentitiesOnly=yes \
                  -o BatchMode=yes \
                  -o ConnectTimeout=10 \
                  -o StrictHostKeyChecking=yes \
                  -o UserKnownHostsFile="$STAGE5_KNOWN_HOSTS" \
                  "$STAGE5_DEPLOY_USER@$STAGE5_HOST" \
                  "deploy maintenance-page" \
                  > artifacts/stage5-deploy.json \
                  2> artifacts/stage5-deploy-error.txt
              '''
            )
          }

          env.STAGE5_DEPLOY_RC = rc.toString()

          if (rc == 0) {
            def a = new groovy.json.JsonSlurperClassic().parseText(readFile('artifacts/stage5-deploy.json'))

            if (a.schema_version != 1 || a.mode != 'stage5-pilot' ||
                a.action != 'deploy' || a.pilot_id != env.STAGE5_PILOT_ID ||
                a.service != env.STAGE5_SERVICE ||
                a.candidate != env.STAGE5_CANDIDATE ||
                a.rollback != env.STAGE5_ROLLBACK ||
                a.deployment?.allowed != true || a.deployment?.performed != true ||
                a.result != 'success') {
              error('Stage 5 deploy artifact failed exact assertions')
            }

            echo('PASS: exact candidate deployed and host helper invariants passed')
          } else {
            echo("Stage 5 deploy command failed with rc=${rc}; reviewed rollback will be attempted")
          }
        }
      }
    }

    stage('Rollback on deploy failure') {
      when {
        expression {
          return env.STAGE5_DEPLOY_RC != null && env.STAGE5_DEPLOY_RC != '0'
        }
      }
      steps {
        script {
          int rollbackRc = 99

          withCredentials([
            sshUserPrivateKey(
              credentialsId: 'homelab-stage5-testserver-executor',
              keyFileVariable: 'STAGE5_ROLLBACK_KEY',
              usernameVariable: 'STAGE5_ROLLBACK_USER'
            )
          ]) {
            rollbackRc = sh(
              returnStatus: true,
              script: '''
                set +x

                ssh \
                  -i "$STAGE5_ROLLBACK_KEY" \
                  -o IdentitiesOnly=yes \
                  -o BatchMode=yes \
                  -o ConnectTimeout=10 \
                  -o StrictHostKeyChecking=yes \
                  -o UserKnownHostsFile="$STAGE5_KNOWN_HOSTS" \
                  "$STAGE5_ROLLBACK_USER@$STAGE5_HOST" \
                  "rollback maintenance-page" \
                  > artifacts/stage5-rollback.json \
                  2> artifacts/stage5-rollback-error.txt
              '''
            )
          }

          env.STAGE5_ROLLBACK_RC = rollbackRc.toString()

          if (rollbackRc != 0) {
            error(
              'Stage 5 deploy failed and reviewed rollback did not succeed. ' +
              'Execution remains armed for controlled manual recovery; no improvised Docker action is permitted.'
            )
          }

          def a = new groovy.json.JsonSlurperClassic().parseText(readFile('artifacts/stage5-rollback.json'))

          if (a.schema_version != 1 || a.mode != 'stage5-pilot' ||
              a.action != 'rollback' || a.pilot_id != env.STAGE5_PILOT_ID ||
              a.service != env.STAGE5_SERVICE ||
              a.candidate != env.STAGE5_CANDIDATE ||
              a.rollback != env.STAGE5_ROLLBACK ||
              a.deployment?.allowed != true || a.deployment?.performed != true ||
              a.rollback_performed != true || a.result != 'success') {
            error('Stage 5 rollback artifact failed exact assertions')
          }

          echo('PASS: reviewed rollback restored exact rollback identity')
        }
      }
    }

    stage('Disarm terminal state') {
      when {
        expression {
          return env.STAGE5_DEPLOY_RC == '0' || env.STAGE5_ROLLBACK_RC == '0'
        }
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'homelab-stage5-testserver-executor',
            keyFileVariable: 'STAGE5_DISARM_KEY',
            usernameVariable: 'STAGE5_DISARM_USER'
          )
        ]) {
          sh '''
            set -eu
            set +x

            ssh \
              -i "$STAGE5_DISARM_KEY" \
              -o IdentitiesOnly=yes \
              -o BatchMode=yes \
              -o ConnectTimeout=10 \
              -o StrictHostKeyChecking=yes \
              -o UserKnownHostsFile="$STAGE5_KNOWN_HOSTS" \
              "$STAGE5_DISARM_USER@$STAGE5_HOST" \
              "disarm maintenance-page" \
              > artifacts/stage5-disarm.json

            test -s artifacts/stage5-disarm.json
          '''
        }

        script {
          def a = new groovy.json.JsonSlurperClassic().parseText(readFile('artifacts/stage5-disarm.json'))

          if (a.schema_version != 1 || a.mode != 'stage5-execution-transition' ||
              a.action != 'disarm' || a.pilot_id != env.STAGE5_PILOT_ID ||
              a.service != env.STAGE5_SERVICE || a.deployment?.activated != false ||
              a.result != 'disarmed') {
            error('Stage 5 disarm artifact failed exact assertions')
          }

          if (env.STAGE5_DEPLOY_RC == '0' && a.current != env.STAGE5_CANDIDATE) {
            error('Successful deployment disarmed with unexpected current digest')
          }

          if (env.STAGE5_ROLLBACK_RC == '0' && a.current != env.STAGE5_ROLLBACK) {
            error('Rollback recovery disarmed with unexpected current digest')
          }

          echo('PASS: one-shot execution authority disarmed')
        }
      }
    }

    stage('Final pipeline result') {
      steps {
        script {
          if (env.STAGE5_DEPLOY_RC == '0') {
            echo('STAGE 5 PILOT RESULT: DEPLOYED EXACT CANDIDATE AND DISARMED')
          } else if (env.STAGE5_ROLLBACK_RC == '0') {
            currentBuild.result = 'FAILURE'
            echo('STAGE 5 PILOT RESULT: DEPLOY FAILED, EXACT ROLLBACK RESTORED AND DISARMED')
          } else {
            error('Stage 5 terminal state is unresolved')
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts(
        artifacts: 'artifacts/stage5-*',
        allowEmptyArchive: true,
        fingerprint: true
      )
    }
  }
}
